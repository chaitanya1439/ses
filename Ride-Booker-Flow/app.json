{
  "expo": {
    "name": "RideGo",
    "slug": "ridego",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ridego",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFB800"
    },
    "updates": {
      "url": "https://u.expo.dev/a017223e-ac28-4be6-b023-0cd9f942b379"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ridego",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RideGo needs your location to find nearby rides and drivers.",
        "NSLocationAlwaysUsageDescription": "RideGo needs your location to track your ride.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ridego",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBXBSZzen8-bLZ_KJURq1sHyc872ubOkDM"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#FFB800",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://ridego.app/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#FFB800",
          "defaultChannel": "ride-alerts"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RideGo needs your location to find nearby rides and drivers."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.20"
          }
        }
      ],
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://ridego.app/"
      },
      "eas": {
        "projectId": "a017223e-ac28-4be6-b023-0cd9f942b379"
      }
    }
  }
}
